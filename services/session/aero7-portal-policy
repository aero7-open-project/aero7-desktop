#!/usr/bin/env python3
"""Disable only the KWallet Secret portal when merged KWallet policy is off.

No persistent user configuration is changed. The session prepends the returned
runtime config directory before starting portals. Explicit user portal choices
and already-enabled wallets are preserved.
"""
import configparser
import os
from pathlib import Path
import subprocess
import sys
import tempfile


def selected_config(env):
    home = Path(env["HOME"])
    user_config = Path(env.get("XDG_CONFIG_HOME") or home / ".config")
    user_data = Path(env.get("XDG_DATA_HOME") or home / ".local/share")
    roots = [user_config]
    roots += [Path(p) for p in (env.get("XDG_CONFIG_DIRS") or "/etc/xdg").split(":") if p]
    roots += [Path("/etc"), user_data]
    roots += [Path(p) for p in (env.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":") if p]
    roots += [Path("/usr/share")]
    names = [d.lower() + "-portals.conf" for d in env.get("XDG_CURRENT_DESKTOP", "Aero7:KDE").split(":") if d]
    names.append("portals.conf")
    seen = set()
    for root in roots:
        if root in seen or not root.is_absolute():
            continue
        seen.add(root)
        for name in names:
            candidate = root / "xdg-desktop-portal" / name
            if candidate.is_file():
                return candidate, root in (user_config, user_data)
    return None, False


def prepare(env, enabled):
    # Invalid/unknown values fail open to the administrator's existing policy.
    if enabled.strip().lower() != "false":
        return None
    source, user_owned = selected_config(env)
    if not source or user_owned:
        return None
    config = configparser.ConfigParser(interpolation=None, strict=True)
    config.optionxform = str
    with source.open(encoding="utf-8") as stream:
        config.read_file(stream)
    key = "org.freedesktop.impl.portal.Secret"
    value = config.get("preferred", key, fallback="")
    if value.strip().rstrip(";") != "kwallet":
        return None
    runtime = env.get("XDG_RUNTIME_DIR", "")
    # Never use a shared /tmp directory for an activation-policy override.
    if not runtime or not Path(runtime).is_absolute():
        return None
    runtime_path = Path(runtime)
    stat = runtime_path.stat()
    if stat.st_uid != os.getuid() or stat.st_mode & 0o077:
        return None
    prefix = runtime_path / "aero7-desktop/portal-config"
    destination = prefix / "xdg-desktop-portal"
    destination.mkdir(parents=True, mode=0o700, exist_ok=True)
    os.chmod(prefix, 0o700)
    os.chmod(destination, 0o700)
    config.set("preferred", key, "none")
    # startplasma-wayland resets XDG_CURRENT_DESKTOP to KDE. Cover both the
    # session wrapper's identity and the identity used by activated portals.
    for name in ("aero7-portals.conf", "kde-portals.conf"):
        fd, temporary = tempfile.mkstemp(dir=destination, prefix=".policy-")
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as stream:
                config.write(stream, space_around_delimiters=False)
            os.replace(temporary, destination / name)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
    return prefix


def main():
    try:
        result = subprocess.run(
            ["kreadconfig6", "--file", "kwalletrc", "--group", "Wallet",
             "--key", "Enabled", "--default", "true"],
            capture_output=True, text=True, check=True, timeout=5)
        prefix = prepare(os.environ, result.stdout)
        if prefix:
            print(prefix)
    except (OSError, ValueError, configparser.Error, subprocess.SubprocessError):
        print("Aero7: retained existing portal policy; vault policy could not be resolved.", file=sys.stderr)


if __name__ == "__main__":
    main()
