[Unit]
Description=Aero7 synchronized multi-monitor taskbar
StartLimitIntervalSec=30s
StartLimitBurst=5
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/aero7-taskbar
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s

[Install]
WantedBy=graphical-session.target
