[Unit]
Description=Aero7 notification area and system status
StartLimitIntervalSec=30s
StartLimitBurst=5
After=graphical-session.target NetworkManager.service pipewire.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/aero7-tray
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s

[Install]
WantedBy=graphical-session.target
