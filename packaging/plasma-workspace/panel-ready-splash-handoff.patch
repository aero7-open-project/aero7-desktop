+
+void ShellCorona::finishStartupSplashWhenUiReady()
+{
+    // Desktop containments can become ready before the saved panels have even
+    // been created. Do not uncover a desktop with a missing taskbar.
+    if (!m_initialLayoutLoaded || numScreens() == 0 || !m_waitingPanels.isEmpty()) {
+        return;
+    }
+    for (int screen = 0; screen < numScreens(); ++screen) {
+        if (!isScreenUiReady(screen)) {
+            return;
+        }
+    }
+
+    qCDebug(PLASMASHELL) << "Plasma Shell startup completed with panels ready";
+    if (!m_startupSplashNotifier) {
+        m_startupSplashNotifier = new StartupSplashNotifier(this);
+    }
+    m_startupSplashNotifier->notify();
 }
 
