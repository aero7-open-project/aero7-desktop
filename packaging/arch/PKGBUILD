pkgname=aero7-desktop
pkgver=0.2.0
pkgrel=33
pkgdesc="Aero7-owned Wayland desktop session and shell integration"
arch=('x86_64')
options=('!debug')
url="https://github.com/aero7-open-project/aero7-desktop"
license=('MIT')
depends=(
  'bash'
  'python'
  'fontconfig'
  'ttf-dejavu'
  'systemd'
  'kwin'
  'plasma-workspace'
  'qt6-declarative'
  'networkmanager'
  'pipewire-pulse'
  'aero7-file-explorer'
  'aero7-gadgets'
  'aero7-internet-explorer'
  'ark'
  'aerothemeplasma-desktop'
  'linux-control-panel'
  'aero7-device-manager'
  'aero7-computer-management-git'
)
optdepends=(
  'aero7-programs-center-git: optional Programs Center Beta'
  'aero7-credential-vault: optional encrypted Credential Manager'
)
makedepends=('cmake' 'ninja' 'gettext' 'git')
# Working-tree source template. Create the archive with
# packaging/create-source-snapshot.py; release staging must pin its SHA-256.
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S "$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DBUILD_TESTING=OFF \
    -DAERO7_INSTALL_TEST_TOOLS="${AERO7_INSTALL_TEST_TOOLS:-OFF}"
  cmake --build build
}

check() {
  cmake -S "$pkgname-$pkgver" -B test-build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DBUILD_TESTING=ON
  cmake --build test-build
  ctest --test-dir test-build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname-$pkgver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$pkgname-$pkgver/docs/RECOVERY.md" \
    "$pkgdir/usr/share/doc/$pkgname/RECOVERY.md"
  install -d "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
  local unit
  for unit in aero7-session-setup aero7-shell; do
    ln -s "../$unit.service" \
      "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/$unit.service"
  done
}
