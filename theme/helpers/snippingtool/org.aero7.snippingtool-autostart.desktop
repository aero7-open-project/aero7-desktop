[Desktop Entry]
Name=Aero7 Snipping Tool Service
Comment=Provides the Aero7 screenshot shortcut and clipboard service
Exec=aero7-snipping-tool --daemon
Icon=aero7-snipping-tool
Terminal=false
Type=Application
OnlyShowIn=KDE;
NoDisplay=true
X-KDE-autostart-after=panel
X-KDE-StartupNotify=false
X-KDE-Wayland-Interfaces=zkde_screencast_unstable_v1
